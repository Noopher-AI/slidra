{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "types": ["node"]
  },
  "include": ["types/**/*.d.ts", "lib/**/*.js", "tools/**/*.mjs", "test/**/*.mjs", "e2e/**/*.mjs", "playwright.config.mjs", "app/**/*.js", "app/**/*.jsx"],
  "exclude": ["node_modules", ".next"]
}
