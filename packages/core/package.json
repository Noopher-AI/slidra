{
  "name": "@co-motion/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b && node -e \"require('node:fs').cpSync('src/assets','dist/assets',{recursive:true})\""
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./text-metrics": {
      "types": "./dist/text-metrics.d.ts",
      "default": "./dist/text-metrics.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "default": "./dist/chart/index.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "default": "./dist/embed.js"
    }
  }
}
