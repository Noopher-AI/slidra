{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@co-motion/core/text-metrics": ["../core/src/text-metrics.ts"],
      "@co-motion/core/geometry": ["../core/src/geometry/index.ts"],
      "@co-motion/core/slide": ["../core/src/slide/index.ts"],
      "@co-motion/core/text": ["../core/src/text/index.ts"],
      "@co-motion/core/effects": ["../core/src/effects/index.ts"],
      "@co-motion/core/clipboard": ["../core/src/element-clipboard.ts"]
    }
  },
  "include": ["src"]
}
