      "file": "decks/slide-not-well-formed.slidra",
      "rule": "playback §4",
      "description": "A slide that is not well-formed XML shows as an error slide, the deck still opens.",
      "expect": {
        "open": "accept",
        "slides": [
          {
            "status": "corrupt"
          },
          {
            "status": "ok"
          }
        ]
      }
