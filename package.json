{
  "name": "co-motion-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "typecheck": "tsc -b && tsc -p packages/web --noEmit && tsc -p e2e/visual-qa --noEmit",
    "visual-qa": "npm run build && vitest run --config e2e/visual-qa/vitest.config.ts",
    "verify:setup": "./quick_start.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "subset-font": "^2.5.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
