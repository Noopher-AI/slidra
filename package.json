  "description": "The open .slidra presentation format specification and a Next.js viewer that plays .slidra decks in the browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test --no-warnings \"test/*.test.mjs\"",
    "examples": "node --no-warnings tools/build-examples.mjs"
  },
  "keywords": [
    "slidra",
    "presentation",
    "slides",
    "svg",
    "viewer",
    "sqlite"
