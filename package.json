{
  "name": "slidra-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && (command -v cargo >/dev/null 2>&1 || (echo 'Rust toolchain required: install it first (e.g. run rustup show per rust-toolchain.toml), then retry' >&2; exit 1)) && cargo build --release && node scripts/link-cli.mjs",
    "test": "npm run build && vitest run",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "typecheck": "tsc -b && tsc -p apps/web --noEmit",
    "verify:setup": "./quick_start.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "@vercel/functions": "^3.9.7",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^4.10.38",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "subset-font": "^2.5.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "ws": "^8.21.3"
  }
}
