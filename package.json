{
  "name": "co-motion-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "typecheck": "tsc -b && tsc -p packages/web --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
