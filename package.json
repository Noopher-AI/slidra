{
  "name": "slidra",
  "version": "0.1.0",
  "description": "The open .slidra presentation format specification and a Next.js viewer that plays .slidra decks in the browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test --no-warnings \"test/*.test.mjs\"",
    "examples": "node --no-warnings tools/build-examples.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "test:e2e": "playwright test",
    "conformance": "node --no-warnings tools/build-conformance.mjs",
    "validate": "node --no-warnings bin/slidra-validate.mjs",
    "fuzz": "FUZZ_ITERATIONS=${FUZZ_ITERATIONS:-50000} node --test --no-warnings test/fuzz.test.mjs"
  },
  "keywords": [
    "slidra",
    "presentation",
    "slides",
    "svg",
    "viewer",
    "sqlite"
  ],
  "private": true,
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "bin": {
    "slidra-validate": "bin/slidra-validate.mjs"
  }
}
