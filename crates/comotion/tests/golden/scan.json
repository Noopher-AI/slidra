  "errors": [
    {
      "label": "empty-tag-name",
      "svg": "<>",
      "expectedMessage": "標記語法錯誤：第 1 行第 1 欄 不是合法的標籤"
    },
    {
      "label": "open-tag-missing-gt",
      "svg": "<foo note=\"測試\"",
      "expectedMessage": "標記語法錯誤：第 1 行第 1 欄 的 <foo> 標籤沒有結尾的 >"
    },
    {
      "label": "attribute-name-unparseable",
      "svg": "<a =\"x\"/>",
      "expectedMessage": "屬性語法錯誤：無法解析屬性名稱"
    },
    {
      "label": "attribute-missing-equals",
      "svg": "<a bar/>",
      "expectedMessage": "屬性語法錯誤：屬性 bar 缺少 ="
    },
    {
      "label": "attribute-value-not-quoted",
      "svg": "<a bar=1/>",
      "expectedMessage": "屬性語法錯誤：屬性 bar 的值未以引號括住"
    },
    {
      "label": "attribute-value-quote-unterminated",
      "svg": "<a \"=\"/>",
      "expectedMessage": "屬性語法錯誤：屬性 \" 的引號未封閉"
    },
    {
      "label": "close-tag-missing-gt",
      "svg": "<a></a",
      "expectedMessage": "標記語法錯誤：第 1 行第 4 欄 的結束標籤沒有結尾的 >"
    },
    {
      "label": "stray-close-tag-at-top-level",
      "svg": "<a></a></a>",
      "expectedMessage": "標記語法錯誤：第 1 行第 8 欄 出現多餘的結束標籤"
    },
    {
      "label": "close-tag-name-mismatch",
      "svg": "<a></b>",
      "expectedMessage": "標記語法錯誤：第 1 行第 4 欄 的結束標籤是 </b>，但目前開啟的是 <a>"
    },
    {
      "label": "eof-with-unclosed-element",
      "svg": "<a><b></b>",
      "expectedMessage": "標記語法錯誤：<a> 沒有對應的結束標籤"
    },
    {
      "label": "unclosed-processing-instruction",
      "svg": "<a><?pi unterminated</a>",
      "expectedMessage": "標記語法錯誤：第 1 行第 4 欄 的註解或宣告沒有結尾"
    }
  ]
